# Server-only upstream origins. Never prefix these with NEXT_PUBLIC_.
ORDERS_SERVICE_URL=http://127.0.0.1:3000
PAYMENT_SERVICE_URL=http://127.0.0.1:3001
INVENTORY_SERVICE_URL=http://127.0.0.1:3002
SHIPPING_SERVICE_URL=http://127.0.0.1:3003
# Auth Service must be a private HTTPS origin in production.
AUTH_SERVICE_URL=http://127.0.0.1:3005

# Total proxy request deadline (request body, connection, and response body).
# Allowed: 100–120000 milliseconds. Default: 10000.
BACKEND_TIMEOUT_MS=10000
# Hosted deployments: same server-only token as the Render services.
# Never expose it through NEXT_PUBLIC_* or commit a real value.
# BACKEND_API_TOKEN=
# Shared only with Auth Service to authenticate trusted client-IP forwarding.
# Never expose it through NEXT_PUBLIC_* or commit a real value.
# AUTH_PROXY_TOKEN=
