{
  "name": "@saga/web",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "type": "module",
  "scripts": {
    "test:state": "npm run build --workspace @saga/shared && tsx --test --test-isolation=none tests/state/*.test.ts tests/state/*.test.tsx",
    "predev": "npm run build --workspace @saga/shared",
    "prebuild": "npm run build --workspace @saga/shared",
    "pretypecheck": "npm run build --workspace @saga/shared",
    "test:api": "npm run build --workspace @saga/shared && node --import tsx --test --test-isolation=none tests/api/*.test.ts",
    "test:api:e2e": "node --import tsx --test --test-isolation=none tests/api-integration.test.ts",
    "dev": "next dev --port 3004",
    "build": "next build --webpack",
    "start": "next start --port 3004",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:ui": "tsx --test tests/ui.test.tsx"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@saga/shared": "0.1.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  }
}
