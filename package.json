{
  "name": "saga-order-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @saga/web",
    "dev:all": "concurrently -k -n backend,web \"npm run dev\" \"npm run dev:web\"",
    "build:web": "npm run build --workspace @saga/web",
    "start:web": "npm run start --workspace @saga/web",
    "dev": "concurrently -k -n payment,inventory,shipping,orders \"npm run dev -w payment-service\" \"npm run dev -w inventory-service\" \"npm run dev -w shipping-service\" \"npm run dev -w order-orchestrator\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run build --workspace @saga/shared && npm run typecheck --workspaces",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "test": "npm run build && node --test --test-isolation=none --test-reporter=spec shared/test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "predev": "npm run build --workspace @saga/shared",
    "db:generate": "npm run db:generate --workspaces --if-present",
    "migrate": "npm run migrate --workspaces --if-present",
    "db:seed": "npm run db:seed --workspace inventory-service",
    "test:db": "npm run build && node --test --test-isolation=none --test-reporter=spec tests/database/*.test.mjs",
    "check:all": "npm run check && npm run test:db && npm run test:payment && npm run test:inventory && npm run test:shipping && npm run test:orchestrator && npm run test:messaging && npm run test:recovery && npm run test:system",
    "test:payment": "npm run build && node --test --test-isolation=none --test-reporter=spec tests/payment/*.test.mjs",
    "test:inventory": "npm run build && node --test --test-isolation=none --test-reporter=spec tests/inventory/*.test.mjs",
    "test:shipping": "npm run build && node --test --test-isolation=none --test-reporter=spec tests/shipping/*.test.mjs",
    "test:orchestrator": "npm run build && node --test --test-isolation=none --test-reporter=spec tests/orchestrator/*.test.mjs",
    "test:messaging": "npm run build && node --test --test-isolation=none --test-reporter=spec tests/messaging/*.test.mjs",
    "test:recovery": "npm run build && node --test --test-isolation=none --test-reporter=spec tests/recovery/*.test.mjs",
    "test:system": "npm run build && node --test --test-isolation=none --test-reporter=spec tests/system/*.test.mjs"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
