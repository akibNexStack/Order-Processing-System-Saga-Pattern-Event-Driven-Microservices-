PORT=3005
DATABASE_URL=postgresql://saga:saga@localhost:5437/saga
# Comma-separated workspace administrators. Set before registering those accounts.
ADMIN_EMAILS=
# Use `log` only for local development. Production requires `smtp`.
AUTH_PUBLIC_URL=http://localhost:3004
AUTH_EMAIL_MODE=log
# Local development only: raise this when repeatedly testing account creation.
# Production keeps the secure default of 5 registrations per client per hour.
# AUTH_REGISTER_RATE_LIMIT_MAX=100
# Required when AUTH_EMAIL_MODE=smtp. For Gmail: smtp.gmail.com, port 465,
# SMTP_SECURE=true, and a Google App Password (not your normal password).
# AUTH_EMAIL_FROM=yourgmail@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your_16_character_google_app_password
SESSION_CLEANUP_INTERVAL_MS=3600000
