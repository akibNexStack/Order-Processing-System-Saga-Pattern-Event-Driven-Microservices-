{
  "name": "@saga/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./http": {
      "types": "./dist/http/auth.d.ts",
      "default": "./dist/http/auth.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/providers.d.ts",
      "default": "./dist/testing/providers.js"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.ts",
      "default": "./dist/messaging/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  }
}
